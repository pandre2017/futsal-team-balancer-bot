# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to use the bot
WHITELISTED_CHAT_IDS=

# polling for local development; webhook for Cloud Run
BOT_MODE=polling
# Must match the value stored in Secret Manager; generate with secrets.token_hex(32)
TELEGRAM_WEBHOOK_SECRET=
# Full HTTPS endpoint, used only by manage_webhook.py set
WEBHOOK_URL=
# HTTP port for webhook mode
PORT=8080

# Set csv or google_sheets, then restart the bot. Rosters load once at startup.
PLAYERS_SOURCE=csv
PLAYERS_FILE=players.csv

# Local JSON key; leave unset in Cloud Run to use its attached service account
GOOGLE_APPLICATION_CREDENTIALS=.secrets/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE="'Players'!A:Z"
