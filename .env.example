# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to use the bot
WHITELISTED_CHAT_IDS=

# Set csv or google_sheets, then restart the bot. Rosters load once at startup.
PLAYERS_SOURCE=csv
PLAYERS_FILE=players.csv

# Required for google_sheets; also used by --print-google-sheet
GOOGLE_APPLICATION_CREDENTIALS=.secrets/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE="'Players'!A:Z"
